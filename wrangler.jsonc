{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zbtdarkweb-scan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["7 * * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER", "remote": true },
  "d1_databases": [{ "binding": "DB", "database_name": "zebrabyte-darkweb-intelligence-prod", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "9ee928c8c1e34301afbb4847be531404" }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "zbtdarkweb-scan-evidence" }],
  "ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "default", "remote": true }],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "zebrabyte_darkweb_usage" }],
  "ratelimits": [
    { "name": "FREE_RATE_LIMITER", "namespace_id": "41001", "simple": { "limit": 10, "period": 60 } },
    { "name": "PAID_RATE_LIMITER", "namespace_id": "41002", "simple": { "limit": 120, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATIONS", "queue": "zebrabyte-darkweb-notifications" },
      { "binding": "MONITORING", "queue": "zebrabyte-darkweb-monitoring" }
    ],
    "consumers": [
      { "queue": "zebrabyte-darkweb-notifications", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "zebrabyte-darkweb-notifications-dlq" },
      { "queue": "zebrabyte-darkweb-monitoring", "max_batch_size": 1, "max_batch_timeout": 2, "max_retries": 10, "retry_delay": 120, "max_concurrency": 1, "dead_letter_queue": "zebrabyte-darkweb-monitoring-dlq" }
    ]
  },
  "workflows": [{ "name": "zebrabyte-darkweb-investigation", "binding": "INVESTIGATION_WORKFLOW", "class_name": "InvestigationWorkflow", "limits": { "steps": 10000 } }],
  "containers": [{ "name": "zebrabyte-darkweb-scan-darkwebcontainer", "class_name": "TorCollector", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }],
  "durable_objects": { "bindings": [{ "name": "TOR_COLLECTOR", "class_name": "TorCollector" }] },
  "exports": {
    "DarkwebContainer": { "type": "durable-object", "state": "renamed", "renamed_to": "TorCollector" },
    "TorCollector": { "type": "durable-object", "storage": "sqlite" }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_NAME": "ZebraByte Dark Web Intelligence",
    "EVIDENCE_RETENTION_DAYS": "90",
    "MAX_SELECTED_SOURCES": "8",
    "MAX_QUERY_CHARS": "300",
    "ALLOWED_BROWSER_HOSTS": "zebrabyte.ro,zebrabyte.co.uk",
    "EMAIL_FROM": "security@zebrabyte.ro",
    "PLAN_FREE_INVESTIGATIONS": "3",
    "PLAN_PRO_INVESTIGATIONS": "100",
    "PLAN_BUSINESS_INVESTIGATIONS": "1000",
    "PLAN_ENTERPRISE_INVESTIGATIONS": "10000"
  }
}
