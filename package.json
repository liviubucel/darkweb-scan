{
  "name": "zebrabyte-darkweb-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "wrangler dev --remote",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "cf-types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "wrangler deploy",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "typescript": "5.9.2",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
