{
  "name": "zebrabyte-darkweb-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "postinstall": "node scripts/prepare-cloudflare-config.mjs && vite build --config apps/client/vite.config.ts",
    "dev": "wrangler dev --remote",
    "build:ui": "vite build --config apps/client/vite.config.ts",
    "build": "vite build --config apps/client/vite.config.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "vite build --config apps/client/vite.config.ts && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "cf-types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "wrangler deploy",
    "dashboard:install": "npm install --prefix apps/dashboard --no-audit --no-fund",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "dashboard:preview": "npm --prefix apps/dashboard run preview",
    "dashboard:deploy": "npm --prefix apps/dashboard run deploy",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloudflare/containers": "0.3.7",
    "@tabler/icons-react": "^3.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "vite": "latest",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
